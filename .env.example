WOLVESVILLE_BOT_API_KEY=<YOUR_WOLVESVILLE_BOT_API_KEY>
WOLVESVILLE_CLAN_ID=<YOUR_WOLVESVILLE_CLAN_ID>

# Time zone used by every cron job
TIME_ZONE=Europe/Berlin

# Only log the planned actions instead of claiming, shuffling or sending
DRY_RUN=false

# Clan quest automation
QUEST_ENABLED=true
QUEST_TIME=20:00
# QUEST_CRON=0 0 20 * * *   # optional, overrides QUEST_TIME
QUEST_ANNOUNCE=true
QUEST_RUN_ON_START=false

# Fallback message, only used when config/auto-messages.json is missing
CLAN_MESSAGE_CONTENT="🔥 | Please vote for the next Clan Quest"
